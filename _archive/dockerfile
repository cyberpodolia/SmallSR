FROM nvidia/cuda:12.2.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    git ca-certificates \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip

COPY python/requirements.base.txt /tmp/requirements.base.txt
COPY python/requirements.gpu.txt /tmp/requirements.gpu.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.base.txt -r /tmp/requirements.gpu.txt

WORKDIR /app
COPY . /app

CMD ["bash"]
